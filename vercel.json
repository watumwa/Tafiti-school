{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "DJANGO_API_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "django",
      "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then DJANGO_SETTINGS_MODULE=core.settings.production python manage.py migrate --noinput; fi",
      "functions": {
        "**": {
          "excludeFiles": "{static/**,staticfiles/**,public/static/**,media/**,tests/**,**/test_*.py,**/*.test.py}"
        }
      }
    }
  },
  "crons": [
    {
      "path": "/api/maintenance/library-daily",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/maintenance/outbound",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
