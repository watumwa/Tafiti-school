# Django
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:3000

# Local database (development defaults to SQLite; these are optional)
USE_SQLITE=true
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=schooldb
# DB_USER=schooluser
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=3306

# Production database (preferred on hosted environments)
# DATABASE_URL=mysql://user:password@host:3306/database

# Vercel Blob media storage (production)
# When a Blob store is connected to the Vercel project this is normally
# injected by Vercel. Never commit the real token to source control.
BLOB_READ_WRITE_TOKEN=

# Scheduled maintenance
# Use one strong random value in Vercel Production for the cron Authorization header.
CRON_SECRET=replace-with-a-long-random-secret

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=bayern-learningcenter.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=bayan-learningcenter@bayern-learningcenter.com
EMAIL_HOST_PASSWORD=replace-me
DEFAULT_FROM_EMAIL=bayan-learningcenter@bayern-learningcenter.com

# Optional external SMS provider
# Tafiti sends JSON: {"to": "...", "message": "...", "sender_id": "..."}
# using Authorization: Bearer <SMS_PROVIDER_TOKEN>.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
SMS_SENDER_ID=Tafiti

# Optional feature flags
PARENT_PORTAL_ENABLED=true
ADMISSIONS_ENABLED=true
LIBRARY_ENABLED=true
RESULT_VERIFICATION_ENABLED=true

# Parent setup links
PARENT_SETUP_LINK_HOURS=24

# School locale / development URL
TIME_ZONE=Africa/Kampala
DEV_TUNNEL_URL=https://bayan-learningcenter.com
